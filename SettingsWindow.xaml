<Window x:Class="CrosshairOverlay.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Crosshair Settings"
        Width="400" Height="620"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Topmost="True">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="Shape" FontWeight="Bold" Margin="0,0,0,4"/>
            <ComboBox x:Name="ShapeBox" Margin="0,0,0,8">
                <ComboBoxItem Content="Default"/>
                <ComboBoxItem Content="Crosshair"/>
                <ComboBoxItem Content="Dot"/>
                <ComboBoxItem Content="Circle"/>
                <ComboBoxItem Content="T-Bar"/>
            </ComboBox>

            <TextBlock Text="Color" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="ColorBox" Margin="0,0,0,4"/>
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Neon Green" Margin="2" Click="PresetGreen_Click"/>
                <Button Content="Cyan" Margin="2" Click="PresetCyan_Click"/>
                <Button Content="Red" Margin="2" Click="PresetRed_Click"/>
                <Button Content="Yellow" Margin="2" Click="PresetYellow_Click"/>
                <Button Content="White" Margin="2" Click="PresetWhite_Click"/>
            </WrapPanel>

            <TextBlock Text="Outline Color" FontWeight="Bold" Margin="0,0,0,4"/>
            <TextBox x:Name="OutlineColorBox" Margin="0,0,0,8"/>

            <TextBlock Text="Length" FontWeight="Bold" Margin="0,0,0,4"/>
            <Slider x:Name="LengthSlider" Minimum="2" Maximum="120" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Value, ElementName=LengthSlider, StringFormat={}{0:0}}" HorizontalAlignment="Right" Margin="0,-6,0,8" Foreground="Gray"/>

            <TextBlock Text="Thickness" FontWeight="Bold" Margin="0,0,0,4"/>
            <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="12" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Value, ElementName=ThicknessSlider, StringFormat={}{0:0.0}}" HorizontalAlignment="Right" Margin="0,-6,0,8" Foreground="Gray"/>

            <TextBlock Text="Gap" FontWeight="Bold" Margin="0,0,0,4"/>
            <Slider x:Name="GapSlider" Minimum="0" Maximum="60" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Value, ElementName=GapSlider, StringFormat={}{0:0}}" HorizontalAlignment="Right" Margin="0,-6,0,8" Foreground="Gray"/>

            <TextBlock Text="Opacity" FontWeight="Bold" Margin="0,0,0,4"/>
            <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1" Margin="0,0,0,8"/>
            <TextBlock Text="{Binding Value, ElementName=OpacitySlider, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Margin="0,-6,0,8" Foreground="Gray"/>

            <StackPanel x:Name="DotSettingsPanel">
                <TextBlock Text="Dot Size" FontWeight="Bold" Margin="0,0,0,4"/>
                <Slider x:Name="DotSizeSlider" Minimum="1" Maximum="30" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Value, ElementName=DotSizeSlider, StringFormat={}{0:0}}" HorizontalAlignment="Right" Margin="0,-6,0,8" Foreground="Gray"/>

                <TextBlock Text="Dot Opacity" FontWeight="Bold" Margin="0,0,0,4"/>
                <Slider x:Name="DotOpacitySlider" Minimum="0.1" Maximum="1" Margin="0,0,0,8"/>
                <TextBlock Text="{Binding Value, ElementName=DotOpacitySlider, StringFormat={}{0:P0}}" HorizontalAlignment="Right" Margin="0,-6,0,8" Foreground="Gray"/>
            </StackPanel>
            <Slider x:Name="OffsetXSlider" Minimum="-50" Maximum="50" SmallChange="0.1" LargeChange="1" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding Value, ElementName=OffsetXSlider, StringFormat={}{0:0.0}}" HorizontalAlignment="Right" Margin="0,-6,0,8" Foreground="Gray"/>
            <TextBox x:Name="OffsetXBox" Margin="0,0,0,8"/>

            <TextBlock Text="Offset Y" FontWeight="Bold" Margin="0,0,0,4"/>
            <Slider x:Name="OffsetYSlider" Minimum="-50" Maximum="50" SmallChange="0.1" LargeChange="1" Margin="0,0,0,2"/>
            <TextBlock Text="{Binding Value, ElementName=OffsetYSlider, StringFormat={}{0:0.0}}" HorizontalAlignment="Right" Margin="0,-6,0,8" Foreground="Gray"/>
            <TextBox x:Name="OffsetYBox" Margin="0,0,0,8"/>

            <TextBlock Text="Nudge: Ctrl+Arrow keys (global) or buttons:" Margin="0,0,0,4" Foreground="Gray"/>
            <WrapPanel Margin="0,0,0,8">
                <Button Content="Left" Margin="2" Click="NudgeLeft_Click"/>
                <Button Content="Up" Margin="2" Click="NudgeUp_Click"/>
                <Button Content="Right" Margin="2" Click="NudgeRight_Click"/>
                <Button Content="Down" Margin="2" Click="NudgeDown_Click"/>
                <Button Content="Reset" Margin="2" Click="ResetOffset_Click"/>
            </WrapPanel>

            <CheckBox x:Name="VisibleCheck" Content="Visible" Margin="0,0,0,8"/>

            <TextBlock Text="Preview" FontWeight="Bold" Margin="0,8,0,4"/>
            <Border Background="#222222" BorderBrush="Gray" BorderThickness="1" Margin="0,0,0,8" Height="160">
                <Canvas x:Name="PreviewCanvas" Width="160" Height="160"/>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Apply" Width="80" Margin="4" Click="Save_Click"/>
                <Button Content="Close" Width="80" Margin="4" Click="Close_Click"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</Window>
